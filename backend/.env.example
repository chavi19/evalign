# ==============================================================================
# EMS Backend Environment Variables (.env.example)
# Copy this file to .env or set these in your OS / container environment.
# ==============================================================================

# Server Port
SERVER_PORT=8080

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=evaluator_mapping_db
DB_USERNAME=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD

# JPA Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# JWT Security Configuration
JWT_SECRET=evaluator-mapping-system-secret-key-for-jwt-token-generation-2024
JWT_EXPIRATION=86400000

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ALLOWED_ORIGINS=http://localhost:4200
